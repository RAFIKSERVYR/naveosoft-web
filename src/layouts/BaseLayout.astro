---
/**
 * Plantilla base común a todas las páginas.
 * Define la estructura HTML (idioma, cabecera, contenido y pie),
 * carga la tipografía Inter auto-alojada y los estilos globales.
 */
import '@fontsource-variable/inter'; // Tipografía Inter servida desde la propia web
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { title, description, image, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO title={title} description={description} image={image} jsonLd={jsonLd} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#3b82f6" />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <style>
      /* Enlace de accesibilidad para saltar directamente al contenido */
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--color-primary);
        color: #fff;
        padding: 0.6rem 1rem;
        border-radius: 0 0 var(--radius) 0;
        z-index: 100;
      }

      .skip-link:focus {
        left: 0;
        color: #fff;
      }
    </style>
  </body>
</html>
