---
/**
 * Cabecera del sitio con el logo de Forjia y el menú de navegación principal.
 * Resalta el enlace de la página actual, ofrece un menú desplegable en móvil
 * y lleva los dos accesos a la app: "Entrar" y "Empieza gratis" (registro).
 */
import Logo from './Logo.astro';

const navLinks = [
  { href: '/funciones', label: 'Funciones' },
  { href: '/gestorias', label: 'Para gestorías' },
  { href: '/precios', label: 'Precios' },
  { href: '/blog', label: 'Blog' },
  { href: '/contacto', label: 'Contacto' },
];

// Ruta actual (sin barra final) para marcar el enlace activo.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Forjia — inicio">
      <Logo size={34} />
      <span class="logo-text">Forjia</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-burger" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Navegación principal">
      <ul>
        {
          navLinks.map((link) => {
            const linkPath = link.href.replace(/\/$/, '') || '/';
            const isActive = currentPath === linkPath;
            return (
              <li>
                <a href={link.href} aria-current={isActive ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            );
          })
        }
        <li class="nav-login">
          <a href="https://forjia.es" rel="noopener">Entrar</a>
        </li>
        <li class="nav-cta">
          <a href="https://forjia.es/registro" rel="noopener" class="btn btn--primary">
            Empieza gratis
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    gap: 1rem;
  }

  /* Logo */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--color-dark);
    letter-spacing: -0.02em;
  }

  .logo:hover {
    color: var(--color-dark);
  }

  /* Navegación */
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-nav a {
    position: relative;
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.95rem;
    padding-block: 0.35rem;
    transition: color 0.18s ease;
  }

  .site-nav li:not(.nav-cta) a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-nav li:not(.nav-cta) a:hover {
    color: var(--color-dark);
  }

  .site-nav li:not(.nav-cta) a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Enlace "Entrar" (acceso a la app): un poco separado del resto */
  .nav-login {
    margin-left: 0.5rem;
  }

  .nav-login a {
    font-weight: 600;
    color: var(--color-dark);
  }

  .nav-cta a {
    color: var(--color-white);
    padding: 0.6rem 1.15rem;
  }

  .nav-cta a:hover {
    color: var(--color-white);
  }

  /* Menú hamburguesa (oculto en escritorio) */
  .nav-toggle,
  .nav-burger {
    display: none;
  }

  .nav-burger {
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    cursor: pointer;
    border-radius: 8px;
  }

  .nav-burger span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-dark);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Responsive: menú desplegable en móvil */
  @media (max-width: 860px) {
    .nav-burger {
      display: flex;
      align-items: center;
    }

    .site-nav {
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;
      background-color: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 1.5rem 1.25rem;
    }

    .site-nav li {
      border-top: 1px solid var(--color-border);
    }

    .site-nav a {
      display: block;
      padding: 0.9rem 0;
    }

    .nav-login {
      margin-left: 0;
    }

    .nav-cta {
      margin-top: 0.75rem;
      border-top: none !important;
    }

    .nav-cta a {
      width: 100%;
    }

    /* Al marcar la casilla oculta, se despliega el menú */
    .nav-toggle:checked ~ .site-nav {
      max-height: 30rem;
    }

    .nav-toggle:checked ~ .nav-burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle:checked ~ .nav-burger span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle:checked ~ .nav-burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
