---
/**
 * Componente SEO reutilizable.
 * Genera los metadatos, Open Graph, Twitter Cards y la URL canónica
 * de cada página. También permite inyectar datos estructurados (JSON-LD).
 */
interface Props {
  /** Título de la pestaña del navegador y de los buscadores. */
  title: string;
  /** Descripción breve para Google y redes sociales. */
  description: string;
  /**
   * Imagen para compartir en redes (ruta dentro de /public). Que sea JPG o PNG
   * de 1200×630: WhatsApp, LinkedIn y Facebook no enseñan las SVG.
   */
  image?: string;
  /** Datos estructurados JSON-LD (opcional, un objeto o array). */
  jsonLd?: Record<string, any> | Record<string, any>[];
}

// Imagen por defecto al compartir (JPG de 1200×630, 64 KB). Se genera a partir
// de public/og-default.svg: si cambias el diseño, vuelve a sacar el JPG.
const DEFAULT_IMAGE = '/og-forjia.jpg';

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  jsonLd,
} = Astro.props;

// URL canónica de la página actual, calculada a partir del dominio (site).
// Con build.format 'file' Astro genera /funciones.html, pero Vercel la sirve
// en /funciones (cleanUrls). La canónica usa siempre la URL limpia, sin .html.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonicalURL = new URL(cleanPath, Astro.site);
// URL absoluta de la imagen para compartir.
const socialImage = new URL(image, Astro.site);

const siteName = 'Forjia';

// Datos estructurados de la organización (Forjia), comunes a todas las
// páginas. Cada página puede añadir los suyos vía la prop `jsonLd`.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Forjia',
  '@id': new URL('/#organization', Astro.site).href,
  url: new URL('/', Astro.site).href,
  logo: new URL('/favicon.svg', Astro.site).toString(),
  email: 'info@forjia.es',
  description:
    'Forjia es la app de control horario y fichaje para pymes y gestorías en España. Te ayuda a llevar el registro de jornada del art. 34.9 del Estatuto de los Trabajadores.',
  areaServed: 'ES',
  sameAs: ['https://forjia.es'],
  // Sin parentOrganization: Naveosoft es solo el nombre comercial de un
  // autónomo, no una sociedad (ver src/data/titular.ts).
};
---

<!-- Metadatos básicos -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow" />

<!-- Open Graph (redes sociales / WhatsApp) -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={socialImage} />
{image === DEFAULT_IMAGE && (
  <>
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Forjia: el control horario que tu equipo usa cada día" />
  </>
)}
<meta property="og:locale" content="es_ES" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<!-- Datos estructurados de la organización (en todas las páginas) -->
<script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

<!-- Datos estructurados JSON-LD propios de la página (si los aporta) -->
{
  jsonLd && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  )
}
