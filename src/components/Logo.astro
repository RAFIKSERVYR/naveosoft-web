---
/**
 * Isotipo de Forjia: cuadrado de esquinas redondeadas en azul Forjia con
 * una "F" blanca en negrita, igual que el icono de la app.
 * Se usa en la cabecera, el pie y como referencia para el favicon
 * y la imagen para compartir en redes (public/favicon.svg y og-default.svg).
 * Cada instancia genera un id de degradado único para poder usarlo varias
 * veces en la misma página sin conflictos.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
const uid = 'lg' + Math.random().toString(36).slice(2, 8);
const g = `url(#g-${uid})`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Forjia"
  class={className}
>
  <defs>
    <linearGradient id={`g-${uid}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3b82f6" />
      <stop offset="1" stop-color="#1d4ed8" />
    </linearGradient>
  </defs>

  <!-- Cuadrado redondeado azul -->
  <rect x="2" y="2" width="60" height="60" rx="16" fill={g} />
  <!-- Brillo sutil en la parte superior -->
  <rect x="2" y="2" width="60" height="30" rx="16" fill="#ffffff" opacity="0.08" />

  <!-- Letra "F" en negrita, blanca -->
  <path
    d="M22 15h22v9H32v6h10v9H32v10H22z"
    fill="#ffffff"
  />
</svg>
