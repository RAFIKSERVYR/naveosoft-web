---
/**
 * Pie de página del sitio: logo de Forjia, enlaces de producto, recursos,
 * legales (alojados en la propia app, forjia.es), contacto y la mención
 * "Forjia es un producto de Naveosoft" (único lugar de la web donde aparece).
 */
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo" aria-label="Forjia — inicio">
        <Logo size={30} />
        <span class="logo-text">Forjia</span>
      </a>
      <p class="footer-tagline">
        El control horario que tu equipo usa cada día. Fichaje, vacaciones,
        documentos e informes para Inspección, para pymes y gestorías en España.
      </p>
      <div class="footer-badges">
        <span class="footer-badge">Datos alojados en la UE</span>
        <span class="footer-badge">Art. 34.9 ET</span>
      </div>
    </div>

    <nav class="footer-col" aria-label="Producto">
      <h4>Producto</h4>
      <ul>
        <li><a href="/funciones">Funciones</a></li>
        <li><a href="/gestorias">Para gestorías</a></li>
        <li><a href="/precios">Precios</a></li>
        <li>
          <a href="https://forjia.es/comparativa" rel="noopener">Compara precios</a>
        </li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Acceso y recursos">
      <h4>Acceso</h4>
      <ul>
        <li><a href="https://forjia.es/registro" rel="noopener">Empieza gratis</a></li>
        <li><a href="https://forjia.es" rel="noopener">Entrar en la app</a></li>
        <li><a href="/ayuda">Centro de ayuda</a></li>
        <li><a href="/plantilla-registro-horario">Plantilla Excel gratis</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Legal y contacto">
      <h4>Legal y contacto</h4>
      <ul>
        <li><a href="https://forjia.es/privacidad" rel="noopener">Política de privacidad</a></li>
        <li><a href="https://forjia.es/eliminar-cuenta" rel="noopener">Eliminar cuenta</a></li>
        <li><a href="/contacto">Formulario de contacto</a></li>
        <li><a href="mailto:info@forjia.es">info@forjia.es</a></li>
        <li class="footer-support">Soporte por correo: lunes a viernes, 9:00–18:00</li>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Forjia. Todos los derechos reservados.</p>
    <p class="footer-made">Forjia es un producto de Naveosoft.</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-darker);
    color: var(--color-text-on-dark);
    padding-top: 3.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.4fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
  }

  .logo:hover {
    color: var(--color-white);
  }

  .footer-tagline {
    color: var(--color-text-on-dark);
    opacity: 0.75;
    max-width: 24rem;
    font-size: 0.95rem;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .footer-badge {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-on-dark);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .footer-col h4 {
    color: var(--color-white);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-col a {
    color: var(--color-text-on-dark);
    opacity: 0.8;
    font-size: 0.95rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .footer-col a:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  /* Horario de soporte: texto informativo, sin enlace, un poco más discreto. */
  .footer-support {
    color: var(--color-text-on-dark);
    opacity: 0.6;
    font-size: 0.85rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .footer-bottom p {
    color: var(--color-text-on-dark);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      justify-content: center;
      text-align: center;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
