---
/**
 * Página de Contacto (/contacto) de la web de Forjia.
 * Formulario (nombre, email, empresa, mensaje) + email directo info@forjia.es.
 * El formulario YA ESTÁ ACTIVO: envía por fetch a Web3Forms (api.web3forms.com)
 * con una access_key pública y muestra éxito/error sin recargar la página.
 *
 * IMPORTANTE — DESTINATARIO DEL FORMULARIO:
 * El correo al que llegan los mensajes NO se configura aquí, sino en la cuenta
 * de Web3Forms (web3forms.com → Linked Emails). Hoy los mensajes llegan a
 * info@naveosoft.es. PENDIENTE (dueño): cambiarlo a info@forjia.es en
 * web3forms.com → Linked Emails (o crear una access_key nueva asociada a
 * info@forjia.es y sustituir el value del campo oculto "access_key").
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Datos estructurados de contacto (SEO).
const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto — Forjia',
  url: 'https://www.forjia.es/contacto',
  mainEntity: {
    '@type': 'Organization',
    name: 'Forjia',
    email: 'info@forjia.es',
    url: 'https://www.forjia.es',
  },
};
---

<BaseLayout
  title="Contacto — Habla con el equipo de Forjia"
  description="¿Dudas sobre el registro horario de tu empresa o quieres activar Forjia en tu gestoría? Escríbenos a info@forjia.es o por el formulario. Te respondemos sin compromiso."
  jsonLd={contactJsonLd}
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Contacto</span>
      <h1>¿Hablamos del fichaje de tu empresa?</h1>
      <p class="lead">
        Rellena el formulario o escríbenos directamente. Te respondemos lo antes
        posible, sin compromiso y sin tecnicismos.
      </p>
    </div>
  </section>

  <!-- ================= CONTENIDO ================= -->
  <section class="section">
    <div class="container contact-grid reveal">
      <!-- Columna de información -->
      <aside class="contact-info">
        <h2>Escríbenos</h2>
        <p>
          Tanto si eres el jefe de una <strong>pyme</strong> como si llevas una
          <strong>gestoría</strong> y quieres controlar el horario de toda tu
          cartera de clientes, cuéntanos tu caso y te ayudamos a ponerlo en
          marcha.
        </p>

        <div class="info-item">
          <span class="info-icon" aria-hidden="true"><Icon name="mail" size={20} /></span>
          <div>
            <h3>Email</h3>
            <a href="mailto:info@forjia.es">info@forjia.es</a>
          </div>
        </div>

        <div class="info-item">
          <span class="info-icon" aria-hidden="true"><Icon name="chat" size={20} /></span>
          <div>
            <h3>Qué esperar</h3>
            <p>Una respuesta cercana y sin tecnicismos, normalmente en 24-48 h laborables.</p>
          </div>
        </div>

        <div class="info-item">
          <span class="info-icon" aria-hidden="true"><Icon name="smartphone" size={20} /></span>
          <div>
            <h3>¿Prefieres probarlo directamente?</h3>
            <p>
              <a href="https://forjia.es/registro">Empieza gratis</a>: 30 días de
              prueba sin compromiso. Y si ya usas Forjia, entra en
              <a href="https://forjia.es" target="_blank" rel="noopener">forjia.es ↗</a>
            </p>
          </div>
        </div>
      </aside>

      <!-- Columna del formulario -->
      <div class="contact-form-wrap">
        <form
          id="contact-form"
          class="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          novalidate
        >
          <!--
            Clave PÚBLICA de Web3Forms. No es secreta: solo identifica la cuenta
            a la que llegan los mensajes (hoy info@naveosoft.es; ver el comentario
            de cabecera para cambiarlo a info@forjia.es).
          -->
          <input
            type="hidden"
            name="access_key"
            value="336e91f2-74e2-4319-932b-b91d779a5c7d"
          />
          <input
            type="hidden"
            name="subject"
            value="Nuevo mensaje desde el formulario de www.forjia.es"
          />
          <input type="hidden" name="from_name" value="Web Forjia" />

          <div class="field">
            <label for="nombre">Nombre <span class="req">*</span></label>
            <input type="text" id="nombre" name="nombre" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="email">Email <span class="req">*</span></label>
            <input type="email" id="email" name="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="empresa">Empresa</label>
            <input type="text" id="empresa" name="empresa" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="mensaje">Mensaje <span class="req">*</span></label>
            <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
          </div>

          <!-- Campo anti-spam de Web3Forms (invisible para las personas) -->
          <input
            type="checkbox"
            name="botcheck"
            class="hp"
            style="display: none"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="field field--check">
            <input type="checkbox" id="consent" name="consent" required />
            <label for="consent">
              He leído y acepto que mis datos se usen únicamente para responder a
              mi consulta. <span class="req">*</span>
            </label>
          </div>

          <button type="submit" class="btn btn--primary">Enviar mensaje</button>

          <!-- Mensaje de éxito o error tras enviar (lo rellena el script) -->
          <p id="form-status" class="form-status" role="status" hidden></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO más corto */
  .hero {
    background:
      radial-gradient(1200px 500px at 80% -10%, rgba(var(--color-accent-rgb), 0.18), transparent 60%),
      radial-gradient(900px 500px at 0% 0%, rgba(var(--color-primary-rgb), 0.12), transparent 55%),
      var(--color-white);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .hero-inner {
    max-width: 46rem;
  }

  .hero h1 {
    margin-block: 0.5rem 1rem;
  }

  /* Rejilla contacto */
  .contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-info h2 {
    margin-bottom: 0.75rem;
  }

  .contact-info > p {
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .info-icon {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    background: linear-gradient(160deg, rgba(var(--color-primary-rgb), 0.12), rgba(var(--color-accent-rgb), 0.1));
    border: 1px solid rgba(var(--color-primary-rgb), 0.16);
    border-radius: var(--radius);
  }

  .info-item h3 {
    font-size: 1rem;
    margin-bottom: 0.15rem;
  }

  .info-item p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  /* Formulario */
  .contact-form-wrap {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-md);
  }

  .field {
    margin-bottom: 1.25rem;
  }

  .field label {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
    color: var(--color-dark);
  }

  .req {
    color: var(--color-primary);
  }

  .field input,
  .field textarea {
    width: 100%;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-text);
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-white);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.15);
  }

  .field textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* Casilla de consentimiento */
  .field--check {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .field--check input {
    width: auto;
    margin-top: 0.25rem;
    flex-shrink: 0;
    accent-color: var(--color-primary);
  }

  .field--check label {
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  /* Campo trampa oculto */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form .btn {
    width: 100%;
  }

  .form-status {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background-color: var(--color-light-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.95rem;
    text-align: center;
  }

  .form-status--ok {
    background-color: #ecfdf5;
    border-color: #a7f3d0;
    color: #065f46;
  }

  .form-status--error {
    background-color: #fef2f2;
    border-color: #fecaca;
    color: #991b1b;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

<script>
  /*
   * Envío del formulario a través de Web3Forms.
   * Manda los datos sin recargar la página y muestra un mensaje de éxito
   * o de error. Requiere que el campo oculto "access_key" tenga tu clave.
   */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;
  const button = form?.querySelector(
    'button[type="submit"]'
  ) as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Validación de los campos obligatorios del navegador.
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const originalText = button?.textContent ?? 'Enviar mensaje';
    if (button) {
      button.disabled = true;
      button.textContent = 'Enviando…';
    }
    if (status) status.hidden = true;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const data = await response.json();

      if (data.success) {
        form.reset();
        if (status) {
          status.hidden = false;
          status.className = 'form-status form-status--ok';
          status.textContent =
            '¡Gracias! Hemos recibido tu mensaje y te responderemos lo antes posible.';
        }
      } else {
        throw new Error(data.message || 'Error al enviar');
      }
    } catch (error) {
      if (status) {
        status.hidden = false;
        status.className = 'form-status form-status--error';
        status.textContent =
          'No se ha podido enviar el mensaje. Inténtalo de nuevo o escríbenos a info@forjia.es.';
      }
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = originalText;
      }
    }
  });
</script>
