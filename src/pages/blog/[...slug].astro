---
/**
 * Plantilla de artículo individual (/blog/nombre-del-articulo).
 * Astro genera una página por cada archivo de la colección "blog".
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Genera una ruta por cada artículo (excepto borradores).
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(
    (post) => !post.data.draft
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

// Datos estructurados del artículo (SEO).
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  author: {
    '@type': 'Organization',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Forjia',
    url: 'https://naveosoft.es',
  },
};
---

<BaseLayout
  title={`${post.data.title} | Blog de Forjia`}
  description={post.data.description}
  image={post.data.heroImage}
  jsonLd={articleJsonLd}
>
  <article class="section">
    <div class="container article-inner">
      <a href="/blog" class="back-link">&larr; Volver al blog</a>

      <header class="article-header">
        <span class="post-category">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p class="article-meta">
          Por {post.data.author} ·
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <span> · Actualizado el {formatDate(post.data.updatedDate)}</span>
            )
          }
        </p>
      </header>

      {
        post.data.heroImage && (
          <img
            class="article-hero"
            src={post.data.heroImage}
            alt={post.data.title}
            loading="eager"
          />
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        post.data.tags.length > 0 && (
          <ul class="tag-list">
            {post.data.tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )
      }

      <div class="article-cta">
        <p>¿Quieres poner en orden el fichaje de tu empresa o de tus clientes? Prueba Forjia 30 días gratis.</p>
        <a href="https://forjia.es/registro" class="btn btn--primary">Empieza gratis</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-inner {
    max-width: 46rem;
  }

  .back-link {
    display: inline-block;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .post-category {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: var(--color-light-bg);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .article-header h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-bottom: 0.75rem;
  }

  .article-meta {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .article-hero {
    width: 100%;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
  }

  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 2.5rem 0 0;
  }

  .tag-list li {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background-color: var(--color-light-bg);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  .article-cta {
    margin-top: 3rem;
    padding: 2rem;
    text-align: center;
    background-color: var(--color-light-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .article-cta p {
    font-weight: 600;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }
</style>
