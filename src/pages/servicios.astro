---
/**
 * Página de Servicios (/servicios).
 * Presenta el desarrollo de software a medida para pymes:
 * web, apps, automatización y SaaS.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Servicios ofrecidos (tarjetas con detalle).
const services = [
  {
    icon: 'globe',
    title: 'Desarrollo web a medida',
    text: 'Webs corporativas, tiendas y plataformas rápidas y seguras, orientadas a SEO y adaptadas a cualquier dispositivo.',
    points: ['Webs y landings', 'Paneles y áreas privadas', 'Tiendas online'],
  },
  {
    icon: 'smartphone',
    title: 'Aplicaciones y apps',
    text: 'Aplicaciones web y móviles para tu equipo o tus clientes, diseñadas para ser fáciles de usar y fiables.',
    points: ['Apps web (PWA)', 'Aplicaciones internas', 'Portales de cliente'],
  },
  {
    icon: 'automation',
    title: 'Automatización de procesos',
    text: 'Eliminamos tareas repetitivas, conectamos tus herramientas y ahorramos tiempo y errores a tu empresa.',
    points: ['Integraciones entre sistemas', 'Flujos automáticos', 'Informes y avisos'],
  },
  {
    icon: 'rocket',
    title: 'Productos SaaS',
    text: 'Convertimos tu idea en un producto digital escalable, listo para crecer con tu negocio. Como hicimos con Forjia.',
    points: ['Del concepto al producto', 'Arquitectura escalable', 'Mantenimiento y evolución'],
  },
];

// Pasos del proceso de trabajo.
const steps = [
  {
    num: '01',
    title: 'Escuchamos',
    text: 'Analizamos tu necesidad y te proponemos la solución que de verdad encaja, sin humo.',
  },
  {
    num: '02',
    title: 'Diseñamos',
    text: 'Definimos juntos cómo será la herramienta antes de programar, para que no haya sorpresas.',
  },
  {
    num: '03',
    title: 'Desarrollamos',
    text: 'Construimos el software por fases, enseñándote avances para que puedas revisar sobre la marcha.',
  },
  {
    num: '04',
    title: 'Lanzamos y cuidamos',
    text: 'Ponemos en marcha la solución y seguimos a tu lado con soporte y mejoras continuas.',
  },
];

// Datos estructurados de los servicios (SEO).
const servicesJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Desarrollo de software a medida',
  provider: {
    '@type': 'Organization',
    name: 'Naveosoft',
    url: 'https://naveosoft.es',
  },
  areaServed: {
    '@type': 'Country',
    name: 'España',
  },
  description:
    'Desarrollo de software a medida para pymes: aplicaciones web, apps móviles, automatización de procesos y productos SaaS.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de desarrollo',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title },
    })),
  },
};
---

<BaseLayout
  title="Servicios — Desarrollo de software a medida para pymes | Naveosoft"
  description="Naveosoft desarrolla software a medida para pymes: aplicaciones web, apps móviles, automatización de procesos y productos SaaS. De la idea a la puesta en marcha, contigo en cada paso."
  jsonLd={servicesJsonLd}
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Desarrollo a medida</span>
      <h1>Software hecho a la medida de tu empresa</h1>
      <p class="lead">
        En Naveosoft creamos la herramienta que tu pyme necesita: desde una web
        o una app hasta la automatización de tus procesos o un producto SaaS
        completo. Tecnología moderna, trato cercano y acompañamiento en cada paso.
      </p>
      <div class="hero-actions">
        <a href="/contacto" class="btn btn--primary">Cuéntanos tu proyecto</a>
        <a href="#servicios" class="btn btn--secondary">Ver servicios</a>
      </div>
    </div>
  </section>

  <!-- ================= FOTO DESTACADA ================= -->
  <section class="section" style="padding-block: 0 var(--space-section);">
    <div class="container reveal">
      <img
        class="feature-photo"
        src="/images/software-desarrollo.jpg"
        alt="Código de software en pantalla, desarrollo a medida en Naveosoft"
        width="1920"
        height="1280"
        loading="lazy"
      />
    </div>
  </section>

  <!-- ================= ENFOQUE ================= -->
  <section class="section" style="padding-top: 0;">
    <div class="container grid grid--2 whatfor reveal">
      <article>
        <span class="eyebrow">Nuestro enfoque</span>
        <h2>Tecnología que resuelve problemas reales</h2>
        <p>
          No creemos en soluciones enrevesadas. Escuchamos lo que necesitas y
          construimos exactamente eso: una herramienta útil, sencilla de usar y
          preparada para crecer. Hablamos tu idioma, sin tecnicismos.
        </p>
      </article>
      <article>
        <span class="eyebrow">Por qué Naveosoft</span>
        <h2>Cercanía, calidad y acompañamiento</h2>
        <p>
          Somos el equipo detrás de Forjia, así que sabemos lo que es crear y
          mantener un producto de verdad. Te acompañamos desde la primera idea
          hasta mucho después del lanzamiento.
        </p>
      </article>
    </div>
  </section>

  <!-- ================= SERVICIOS ================= -->
  <section id="servicios" class="section section--light">
    <div class="container section-head reveal">
      <span class="eyebrow">Qué hacemos</span>
      <h2>Nuestros servicios</h2>
      <p class="lead">
        Todo lo que tu empresa necesita para dar el salto digital, en un mismo
        equipo.
      </p>
    </div>

    <div class="container" style="margin-top: 3rem;">
      <div class="grid grid--2 reveal">
        {
          services.map((s) => (
            <article class="card service-card">
              <span class="icon-box">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <ul class="mini-list">
                {s.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CÓMO TRABAJAMOS ================= -->
  <section class="section">
    <div class="container section-head reveal">
      <span class="eyebrow">Cómo trabajamos</span>
      <h2>De la idea a la puesta en marcha</h2>
      <p class="lead">
        Un proceso claro y por fases, para que en todo momento sepas dónde está
        tu proyecto.
      </p>
    </div>

    <div class="container" style="margin-top: 3rem;">
      <ol class="steps reveal">
        {
          steps.map((step) => (
            <li class="step">
              <span class="step-num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= CTA FINAL ================= -->
  <section class="section section--dark cta">
    <div class="container section-head reveal">
      <h2>¿Tienes una idea en mente?</h2>
      <p class="lead">
        Cuéntanos qué necesitas y te proponemos cómo hacerlo realidad. Primera
        conversación sin compromiso.
      </p>
      <div class="hero-actions" style="justify-content: center;">
        <a href="/contacto" class="btn btn--primary">Contactar</a>
        <a href="mailto:info@naveosoft.es" class="btn btn--ghost">
          info@naveosoft.es
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO (mismo lenguaje visual) */
  .hero {
    background:
      radial-gradient(1200px 500px at 80% -10%, rgba(var(--color-accent-rgb), 0.18), transparent 60%),
      radial-gradient(900px 500px at 0% 0%, rgba(var(--color-primary-rgb), 0.12), transparent 55%),
      var(--color-white);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero-inner {
    max-width: 46rem;
  }

  .hero h1 {
    margin-block: 0.5rem 1.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* Enfoque */
  .whatfor {
    gap: 3rem;
  }

  .whatfor p {
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .mini-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mini-list li {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-primary);
    background-color: var(--color-light-bg);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  /* Pasos del proceso */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    counter-reset: step;
  }

  .step {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: #fff;
    font-weight: 800;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .step h3 {
    margin-bottom: 0.4rem;
  }

  .step p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 980px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
