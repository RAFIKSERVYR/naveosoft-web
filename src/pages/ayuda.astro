        a: `<p>Escríbenos a <a href="mailto:info@forjia.es">info@forjia.es</a> o usa el <a href="/contacto">formulario de contacto</a>. Atendemos <strong>de lunes a viernes, de 9:00 a 18:00</strong> (hora peninsular), y respondemos siempre por correo.</p>
<p>Para ayudarte más rápido, indícanos el nombre de tu empresa en Forjia, qué estabas haciendo y, si puedes, una captura de pantalla del mensaje que te aparece.</p>`,
      },
    ],
  },
];

const totalPreguntas = bloques.reduce((n, b) => n + b.faqs.length, 0);

// Quita las etiquetas HTML de una respuesta para los datos estructurados.
const soloTexto = (html: string) =>
  html
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

// Datos estructurados FAQPage con todas las preguntas (SEO).
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  name: 'Centro de ayuda de Forjia',
  inLanguage: 'es',
  mainEntity: bloques.flatMap((b) =>
    b.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: soloTexto(f.a) },
    }))
  ),
};
---

<BaseLayout
  title="Centro de ayuda de Forjia — Preguntas frecuentes sobre fichaje, vacaciones e informes"
  description="Resuelve tus dudas sobre Forjia sin escribir a soporte: alta de empleados, cartel QR, fichaje con GPS o kiosco, vacaciones, nóminas con firma, informes para la Inspección de Trabajo, prueba gratuita, planes y gestorías."
  jsonLd={faqJsonLd}
>
  <!-- ================= CABECERA + BUSCADOR ================= -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Centro de ayuda</span>
      <h1>¿En qué te ayudamos?</h1>
      <p class="lead">
        Las {totalPreguntas} preguntas que más nos hacen jefes de pyme y gestorías,
        con los pasos exactos dentro de la app. Escribe una palabra para filtrar.
      </p>

      <form class="search" role="search" onsubmit="return false;">
        <label for="ayuda-buscar" class="sr-only">Buscar en la ayuda</label>
        <span class="search-icon" aria-hidden="true"><Icon name="search" size={20} /></span>
        <input
          type="search"
          id="ayuda-buscar"
          name="q"
          placeholder="Por ejemplo: QR, vacaciones, factura, inspección…"
          autocomplete="off"
          spellcheck="false"
        />
      </form>

      <nav class="chips" aria-label="Bloques de la ayuda">
        {
          bloques.map((b) => (
            <a href={`#${b.id}`} class="chip">
              <Icon name={b.icon} size={16} />
              {b.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- ================= BLOQUES DE PREGUNTAS ================= -->
  <section class="section section--light faq-section">
    <div class="container faq-wrap" id="faq-root">
      {
        bloques.map((b) => (
          <section class="faq-block" id={b.id} data-block>
            <header class="faq-block-head">
              <span class="icon-box"><Icon name={b.icon} /></span>
              <div>
                <h2>{b.title}</h2>
                <p>{b.desc}</p>
              </div>
            </header>
            <div class="faq-list">
              {b.faqs.map((f) => (
                <details class="faq-item" data-faq>
                  <summary>
                    <span>{f.q}</span>
                    <span class="faq-marker" aria-hidden="true"></span>
                  </summary>
                  <div class="faq-answer" set:html={f.a}></div>
                </details>
              ))}
            </div>
          </section>
        ))
      }

      <!-- Aviso cuando el buscador no encuentra nada (lo muestra el script) -->
      <div class="faq-empty" id="faq-empty" hidden>
        <Icon name="help" size={28} />
        <p>
          No hemos encontrado nada con esa palabra. Prueba con otra o
          <a href="/contacto">escríbenos</a> y te respondemos por correo.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= ¿NO ENCUENTRAS LA RESPUESTA? ================= -->
  <section class="section section--dark cta">
    <div class="container section-head reveal">
      <h2>¿No encuentras la respuesta?</h2>
      <p class="lead">
        Escríbenos y te contestamos por correo, de lunes a viernes de 9:00 a
        18:00. Sin robots ni esperas al teléfono.
      </p>
      <div class="cta-actions">
        <a href="/contacto" class="btn btn--primary">
          Ir al formulario de contacto
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="mailto:info@forjia.es" class="btn btn--ghost">
          <Icon name="mail" size={18} />
          info@forjia.es
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Buscador sencillo: filtra las preguntas en el navegador, sin recargar.
  // Oculta las que no coinciden, los bloques que se quedan vacíos y muestra
  // un aviso si no hay resultados. Con texto, abre las coincidencias.
  const input = document.getElementById('ayuda-buscar') as HTMLInputElement | null;
  const bloques = Array.from(document.querySelectorAll<HTMLElement>('[data-block]'));
  const vacio = document.getElementById('faq-empty');
  const normaliza = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function filtrar() {
    const q = normaliza(input?.value.trim() ?? '');
    let visibles = 0;
    bloques.forEach((bloque) => {
      let enBloque = 0;
      bloque.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((item) => {
        const coincide = q === '' || normaliza(item.textContent ?? '').includes(q);
        item.hidden = !coincide;
        if (coincide) enBloque++;
        if (q !== '') item.open = coincide;
      });
      bloque.hidden = enBloque === 0;
      visibles += enBloque;
    });
    if (vacio) vacio.hidden = visibles > 0;
  }

  input?.addEventListener('input', filtrar);
  // Si la página se carga con #ancla, abre ese bloque directamente.
  if (location.hash) document.querySelector(location.hash)?.scrollIntoView();
</script>

<style>
  /* CABECERA */
  .hero {
    background:
      radial-gradient(1200px 500px at 80% -10%, rgba(var(--color-accent-rgb), 0.18), transparent 60%),
      radial-gradient(900px 500px at 0% 0%, rgba(var(--color-primary-rgb), 0.1), transparent 55%),
      var(--color-white);
    padding-block: clamp(3.5rem, 8vw, 5.5rem) 3rem;
  }

  .hero-inner {
    max-width: 48rem;
  }

  .hero h1 {
    margin-block: 0.5rem 1.25rem;
  }

  /* Buscador */
  .search {
    position: relative;
    margin-top: 2rem;
  }

  .search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    display: flex;
  }

  .search input {
    width: 100%;
    font: inherit;
    font-size: 1.05rem;
    color: var(--color-dark);
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    padding: 1rem 1.25rem 1rem 3.1rem;
    box-shadow: var(--shadow-sm);
  }

  .search input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: var(--ring);
  }

  .search input::placeholder {
    color: var(--color-text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Accesos rápidos a los bloques */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    background: var(--color-primary-light);
    border: 1px solid rgba(var(--color-primary-rgb), 0.18);
    border-radius: var(--radius-full);
    padding: 0.45rem 0.9rem;
  }

  .chip:hover {
    background: var(--color-surface);
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  /* BLOQUES */
  .faq-section {
    padding-top: 3.5rem;
  }

  .faq-wrap {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .faq-block {
    scroll-margin-top: 90px;
  }

  .faq-block-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .faq-block-head .icon-box {
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .faq-block-head h2 {
    font-size: 1.5rem;
    margin-bottom: 0.15rem;
  }

  .faq-block-head p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Acordeón */
  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .faq-item[open] {
    border-color: rgba(var(--color-primary-rgb), 0.35);
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-dark);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:focus-visible {
    outline: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--ring);
  }

  /* El "+" que pasa a "−" al abrir */
  .faq-marker {
    position: relative;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-primary-light);
  }

  .faq-marker::before,
  .faq-marker::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-primary);
    border-radius: 1px;
  }

  .faq-marker::before {
    width: 0.75rem;
    height: 2px;
  }

  .faq-marker::after {
    width: 2px;
    height: 0.75rem;
  }

  .faq-item[open] .faq-marker::after {
    display: none;
  }

  .faq-answer {
    margin-top: 0.85rem;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-answer :global(p),
  .faq-answer :global(ul),
  .faq-answer :global(ol) {
    margin: 0;
  }

  .faq-answer :global(ul),
  .faq-answer :global(ol) {
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .faq-answer :global(strong) {
    color: var(--color-dark);
  }

  .faq-answer :global(code) {
    font-size: 0.9em;
    background: var(--color-light-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.1em 0.4em;
  }

  .faq-answer :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Sin resultados */
  .faq-empty {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .faq-empty :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  /* CTA final */
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* Animaciones solo si la persona no ha pedido reducir el movimiento */
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }

    .faq-item,
    .chip,
    .search input {
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    }
  }

  @media (max-width: 640px) {
    .faq-block-head h2 {
      font-size: 1.3rem;
    }

    .faq-item {
      padding: 0.9rem 1rem;
    }
  }
</style>
