---
/**
 * Página de Inicio (/).
 * Presenta a Naveosoft como empresa y dirige a los dos públicos:
 * empresas que buscan una app de fichaje (Forjia) y empresas que
 * buscan desarrollo de software a medida (Servicios).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Servicios destacados en la home.
const services = [
  {
    icon: 'globe',
    title: 'Aplicaciones web',
    text: 'Plataformas y paneles a medida, rápidos y seguros, adaptados a tu forma de trabajar.',
  },
  {
    icon: 'smartphone',
    title: 'Apps y SaaS',
    text: 'Productos digitales para tus clientes o tu equipo, escalables y listos para crecer.',
  },
  {
    icon: 'automation',
    title: 'Automatización',
    text: 'Eliminamos tareas repetitivas y conectamos tus herramientas para ahorrarte tiempo.',
  },
];

// Datos estructurados de la empresa (ayudan al SEO en Google).
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Naveosoft',
  url: 'https://naveosoft.es',
  description:
    'Empresa de desarrollo de software a medida para pymes. Creadores de Forjia, la app de control de presencia y fichaje.',
  email: 'info@naveosoft.es',
  areaServed: 'ES',
  knowsAbout: [
    'Desarrollo de software a medida',
    'Aplicaciones SaaS',
    'Control de presencia y fichaje',
    'Automatización de procesos',
  ],
};
---

<BaseLayout
  title="Naveosoft — Desarrollo de software a medida y app de fichaje Forjia"
  description="Naveosoft desarrolla software a medida para pymes españolas y crea Forjia, la app de control de presencia y fichaje que cumple el RD 8/2019. Descubre nuestros servicios."
  jsonLd={organizationJsonLd}
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow">Software a medida para pymes</span>
      <h1>Construimos el software que tu empresa necesita para crecer</h1>
      <p class="lead">
        En Naveosoft desarrollamos aplicaciones web, apps y soluciones SaaS a
        medida. Y creamos <strong>Forjia</strong>, la app de control de presencia
        y fichaje legal para pymes españolas.
      </p>
      <div class="hero-actions">
        <a href="/forjia" class="btn btn--primary">
          Descubre Forjia
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="/servicios" class="btn btn--secondary">Ver servicios</a>
      </div>
    </div>
  </section>

  <!-- ================= BLOQUE FORJIA ================= -->
  <section class="section section--light">
    <div class="container">
      <div class="split reveal">
        <div class="split-text">
          <span class="eyebrow">Nuestro producto estrella</span>
          <h2>Forjia: fichaje y control de presencia sin complicaciones</h2>
          <p class="lead">
            La app que ayuda a las pymes a cumplir el registro horario legal
            (RD 8/2019) de forma sencilla: fichaje en segundos, verificación por
            ubicación, modo kiosko para tablets, informes mensuales y mucho más.
          </p>
          <ul class="check-list">
            <li><Icon name="check" size={18} /> Cumple con el RD 8/2019 y el RGPD</li>
            <li><Icon name="check" size={18} /> Fichaje en segundos desde el móvil o una tablet</li>
            <li><Icon name="check" size={18} /> Panel de administración e informes automáticos</li>
          </ul>
          <div class="hero-actions">
            <a href="/forjia" class="btn btn--primary">Descubre Forjia</a>
            <a href="https://forjia.es" target="_blank" rel="noopener" class="btn btn--secondary">
              Ir a la app ↗
            </a>
          </div>
        </div>
        <div class="split-visual" aria-hidden="true">
          <div class="mock-card">
            <div class="mock-head">
              <span class="mock-brand">
                <span class="mock-logo"></span> Forjia
              </span>
              <span class="mock-time">09:02</span>
            </div>
            <div class="mock-check">
              <Icon name="check" size={30} />
            </div>
            <p class="mock-title">Fichaje registrado</p>
            <p class="mock-sub">Entrada · Oficina central</p>
            <div class="mock-row">
              <span class="mock-pill"><Icon name="map-pin" size={14} /> Ubicación verificada</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BLOQUE SERVICIOS ================= -->
  <section class="section">
    <div class="container section-head reveal">
      <span class="eyebrow">Desarrollo a medida</span>
      <h2>Convertimos tu idea en software que funciona</h2>
      <p class="lead">
        Si necesitas una herramienta que no existe en el mercado, la creamos
        para ti. Acompañamos a las pymes desde la idea hasta la puesta en marcha.
      </p>
    </div>

    <div class="container" style="margin-top: 3rem;">
      <div class="grid grid--3 reveal">
        {
          services.map((s) => (
            <article class="card">
              <span class="icon-box">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="container text-center" style="margin-top: 3rem;">
      <a href="/servicios" class="btn btn--primary">Ver servicios</a>
    </div>
  </section>

  <!-- ================= LLAMADA A CONTACTO ================= -->
  <section class="section section--dark cta">
    <div class="container section-head reveal">
      <h2>¿Hablamos de tu proyecto?</h2>
      <p class="lead">
        Cuéntanos qué necesitas y te respondemos sin compromiso. Tanto si buscas
        una app de fichaje como un desarrollo a medida, estamos para ayudarte.
      </p>
      <div class="hero-actions" style="justify-content: center;">
        <a href="/contacto" class="btn btn--primary">Contactar</a>
        <a href="mailto:info@naveosoft.es" class="btn btn--ghost">
          info@naveosoft.es
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-white);
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px 460px at 82% -8%, rgba(var(--color-accent-rgb), 0.22), transparent 60%),
      radial-gradient(760px 460px at 2% 4%, rgba(var(--color-primary-rgb), 0.14), transparent 55%);
    z-index: 0;
  }

  /* Cuadrícula decorativa muy tenue */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 23, 42, 0.035) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(700px 420px at 50% 30%, #000, transparent 78%);
    -webkit-mask-image: radial-gradient(700px 420px at 50% 30%, #000, transparent 78%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 48rem;
  }

  .hero h1 {
    margin-block: 0.5rem 1.35rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }

  /* BLOQUE PARTIDO (texto + visual) */
  .split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .check-list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .check-list li :global(svg) {
    flex-shrink: 0;
    width: 1.35rem;
    height: 1.35rem;
    padding: 0.28rem;
    color: #fff;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    border-radius: 50%;
    box-sizing: content-box;
  }

  /* Tarjeta visual simulada de Forjia */
  .split-visual {
    display: flex;
    justify-content: center;
  }

  .mock-card {
    position: relative;
    width: 100%;
    max-width: 340px;
    background: linear-gradient(165deg, #ffffff, #f3f7fd);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .mock-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .mock-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--color-dark);
    font-size: 0.95rem;
  }

  .mock-logo {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  }

  .mock-time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .mock-check {
    width: 68px;
    height: 68px;
    margin: 0.25rem auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    box-shadow: 0 10px 22px -6px rgba(var(--color-primary-rgb), 0.55);
  }

  .mock-title {
    font-weight: 700;
    color: var(--color-dark);
    font-size: 1.1rem;
  }

  .mock-sub {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .mock-row {
    margin-top: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .mock-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    background-color: rgba(var(--color-primary-rgb), 0.08);
    border: 1px solid rgba(var(--color-primary-rgb), 0.16);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .split-visual {
      order: -1;
    }
  }
</style>
