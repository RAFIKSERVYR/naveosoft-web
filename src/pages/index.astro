---
/**
 * Página de Inicio (/): landing de Forjia.
 * Estructura: hero con captura de la app, propuesta de valor, tres bloques
 * (empleado / empresa / gestoría), franja de cumplimiento legal, tira de
 * capturas, resumen de precios con enlace a /precios y CTA final.
 * Incluye datos estructurados SoftwareApplication para el SEO.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Tres públicos, tres beneficios.
const audiences = [
  {
    icon: 'smartphone',
    eyebrow: 'Para el empleado',
    title: 'Fichar en dos toques',
    text: 'Entrada, salida y pausas desde el móvil, la web o la tablet del local. Pide vacaciones, consulta su horario y firma sus documentos sin papeles.',
    points: ['Fichaje con GPS opcional', 'Vacaciones y ausencias', 'Nóminas y contratos firmados con el dedo'],
  },
  {
    icon: 'dashboard',
    eyebrow: 'Para la empresa',
    title: 'Todo el equipo, de un vistazo',
    text: 'Quién trabaja, quién está en pausa y quién ha salido, en tiempo real. Turnos, alertas e informes listos para la Inspección de Trabajo.',
    points: ['Panel en tiempo real con alertas', 'Turnos y cuadrantes', 'Parte de horas PDF, Excel y CSV'],
  },
  {
    icon: 'buildings',
    eyebrow: 'Para la gestoría',
    title: 'Toda tu cartera en un panel',
    text: 'Gestiona varias empresas cliente, entra en cada una como administrador y descarga el informe mensual de toda la cartera en un solo Excel.',
    points: ['Privacidad por defecto', 'Un Excel con una pestaña por empresa', 'Desde 9 € por empresa al mes'],
  },
];

// Tira de capturas de la app (1080×1920, retrato).
const shots = [
  { src: '/img/capturas/2-fichaje.jpg', alt: 'Pantalla de fichaje de Forjia con el cronómetro de la jornada y el botón de fichar salida' },
  { src: '/img/capturas/3-vacaciones.jpg', alt: 'Pantalla de vacaciones y ausencias de Forjia con el saldo de días y las solicitudes' },
  { src: '/img/capturas/4-informes.jpg', alt: 'Pantalla de informes de Forjia: parte de horas en PDF y exportación a Excel' },
  { src: '/img/capturas/5-kiosko.jpg', alt: 'Modo kiosco de Forjia en tablet para fichar con QR o PIN' },
  { src: '/img/capturas/6-empleados.jpg', alt: 'Panel de empleados de Forjia con el estado de cada persona en tiempo real' },
  { src: '/img/capturas/7-documentos.jpg', alt: 'Pantalla de documentos de Forjia con nóminas y contratos firmados desde el móvil' },
  { src: '/img/capturas/8-gestorias.jpg', alt: 'Panel de cartera de Forjia para gestorías con varias empresas cliente' },
];

// Datos estructurados del producto (SEO).
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Forjia',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, Android',
  url: 'https://www.forjia.es',
  installUrl: 'https://forjia.es/registro',
  inLanguage: ['es', 'ca', 'en'],
  description:
    'App de control horario y fichaje para pymes y gestorías en España. Fichaje móvil con GPS opcional, modo kiosco con QR o PIN, turnos, vacaciones, documentos con firma, panel para gestorías e informes para la Inspección de Trabajo (art. 34.9 ET).',
  featureList: [
    'Fichaje desde móvil y web con GPS opcional y varios centros de trabajo',
    'Modo kiosco con QR o PIN para tablet',
    'Turnos y cuadrantes',
    'Vacaciones y ausencias con solicitudes, aprobación y saldo',
    'Documentos (nóminas, contratos) con firma con el dedo',
    'Panel del jefe en tiempo real con alertas',
    'Parte de horas PDF e informe de auditoría para Inspección de Trabajo',
    'Exportación a Excel y CSV para la gestoría',
    'Panel de cartera para gestorías con privacidad por defecto',
    'Informe mensual de toda la cartera en un solo Excel',
  ],
  offers: [
    {
      '@type': 'Offer',
      name: 'Plan Básico',
      price: '15',
      priceCurrency: 'EUR',
      description: 'Desde 15 €/mes por empresa (hasta 5 empleados), IVA no incluido. Prueba de 30 días gratis sin tarjeta.',
    },
    {
      '@type': 'Offer',
      name: 'Plan Completo',
      price: '29',
      priceCurrency: 'EUR',
      description: 'Desde 29 €/mes por empresa (hasta 5 empleados), IVA no incluido. Añade vacaciones, ausencias y documentos con firma.',
    },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'Forjia',
    url: 'https://www.forjia.es',
  },
};
---

<BaseLayout
  title="Forjia — Control horario y fichaje para pymes y gestorías"
  description="Forjia es la app de control horario que tu equipo usa cada día: fichaje móvil con GPS opcional, modo kiosco, vacaciones, documentos con firma e informes para la Inspección de Trabajo. Panel para gestorías. Prueba 30 días gratis sin tarjeta."
  jsonLd={softwareJsonLd}
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="pill pill--success">
          <Icon name="check" size={14} /> Prueba 30 días gratis · sin tarjeta
        </span>
        <h1>El control horario que tu equipo <span class="accent">usa cada día</span></h1>
        <p class="lead">
          Fichaje desde el móvil, informes para la Inspección de Trabajo y todo el
          equipo en un sitio. Para pymes y para las gestorías que las llevan.
        </p>
        <ul class="check-list">
          <li><Icon name="check" size={18} /> Registro de jornada legal (art. 34.9 ET)</li>
          <li><Icon name="check" size={18} /> Fichaje móvil con GPS opcional y modo kiosco</li>
          <li><Icon name="check" size={18} /> Informes y parte de horas en un toque</li>
        </ul>
        <div class="hero-actions">
          <a href="https://forjia.es/registro" rel="noopener" class="btn btn--primary">
            Empieza gratis
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/funciones" class="btn btn--secondary">Ver todas las funciones</a>
        </div>
        <p class="hero-note">
          Sin tarjeta, sin permanencia. En 5 minutos tu equipo está fichando.
        </p>
      </div>

      <div class="hero-visual">
        <img
          src="/img/capturas/hero-movil.jpg"
          alt="Pantalla de fichaje de Forjia en el móvil: cronómetro de la jornada, botón de fichar salida y horas del día"
          width="1080"
          height="1920"
          class="shot hero-shot"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ================= PROPUESTA DE VALOR ================= -->
  <section class="section section--light">
    <div class="container section-head reveal">
      <span class="eyebrow">Por qué Forjia</span>
      <h2>Sencilla para el equipo, completa para la empresa, cómoda para la gestoría</h2>
      <p class="lead">
        La mayoría de apps de fichaje se abandonan a las dos semanas. Forjia está
        pensada para que fichar cueste dos toques y para que los informes salgan
        solos.
      </p>
    </div>

    <div class="container" style="margin-top: 3rem;">
      <div class="grid grid--3 reveal">
        {
          audiences.map((a) => (
            <article class="card audience">
              <span class="icon-box"><Icon name={a.icon} /></span>
              <span class="audience-eyebrow">{a.eyebrow}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <ul class="check-list check-list--compact">
                {a.points.map((p) => (
                  <li><Icon name="check" size={16} /> {p}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CUMPLIMIENTO LEGAL ================= -->
  <section class="section">
    <div class="container">
      <div class="compliance reveal">
        <div class="compliance-badge" aria-hidden="true">
          <Icon name="scale" size={44} />
        </div>
        <div>
          <span class="eyebrow">Cumplimiento legal</span>
          <h2>Tranquilidad ante la Inspección de Trabajo</h2>
          <p class="lead">
            Forjia lleva el registro de jornada conforme al <strong>art. 34.9 del
            Estatuto de los Trabajadores</strong>. Cada fichaje queda guardado con
            su historial de cambios, y el informe de auditoría se descarga con un
            clic.
          </p>
          <ul class="check-list">
            <li><Icon name="check" size={18} /> Correcciones con auditoría inalterable: quién, cuándo y qué cambió</li>
            <li><Icon name="check" size={18} /> Parte de horas en PDF e informe de auditoría listos para Inspección</li>
            <li><Icon name="check" size={18} /> Conservación de los registros durante 4 años</li>
            <li><Icon name="check" size={18} /> Datos alojados en la Unión Europea</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TIRA DE CAPTURAS ================= -->
  <section class="section section--light shots-section">
    <div class="container section-head reveal">
      <span class="eyebrow">Así se ve</span>
      <h2>Una app que apetece abrir</h2>
      <p class="lead">
        Interfaz clara, en español, catalán e inglés, con modo oscuro. Como app
        web (PWA) o desde Google Play.
      </p>
    </div>
    <div class="shots-strip reveal" aria-label="Capturas de pantalla de Forjia">
      {
        shots.map((s) => (
          <figure class="shots-item">
            <img src={s.src} alt={s.alt} width="1080" height="1920" loading="lazy" class="shot" />
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ================= PRECIOS RESUMIDOS ================= -->
  <section class="section">
    <div class="container section-head reveal">
      <span class="eyebrow">Precios</span>
      <h2>Precios claros, por empresa</h2>
      <p class="lead">
        Sin costes de implantación ni permanencia. Paga anual y te regalamos 2
        meses.
      </p>
    </div>

    <div class="container" style="margin-top: 3rem;">
      <div class="grid grid--3 reveal">
        <article class="card price">
          <h3>Básico</h3>
          <p class="price-amount"><span>desde</span> 15 €<small>/mes</small></p>
          <p>Fichaje, turnos, panel en tiempo real, informes para Inspección y Excel para la gestoría.</p>
          <p class="price-tiers">15 € hasta 5 empleados · 25 € hasta 25 · 49 € hasta 50</p>
        </article>
        <article class="card price price--featured">
          <span class="pill">Más elegido</span>
          <h3>Completo</h3>
          <p class="price-amount"><span>desde</span> 29 €<small>/mes</small></p>
          <p>Todo lo del Básico más vacaciones y ausencias, y documentos con firma con el dedo.</p>
          <p class="price-tiers">29 € hasta 5 empleados · 49 € hasta 25 · 99 € hasta 50</p>
        </article>
        <article class="card price">
          <h3>Gestorías</h3>
          <p class="price-amount">9 €<small>/empresa y mes</small></p>
          <p>Panel de cartera, acceso a cada empresa cliente e informe mensual de toda la cartera en un Excel.</p>
          <p class="price-tiers">Mínimo 79 €/mes · <a href="/gestorias">Ver más</a></p>
        </article>
      </div>
      <p class="price-note text-center">
        Precios sin IVA, por empresa. Prueba 30 días gratis sin tarjeta.
      </p>
      <div class="text-center" style="margin-top: 1.5rem;">
        <a href="/precios" class="btn btn--secondary">
          Ver precios al detalle
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- ================= CTA FINAL ================= -->
  <section class="section section--dark cta">
    <div class="container section-head reveal">
      <h2>Empieza hoy. Tu equipo ficha mañana.</h2>
      <p class="lead">
        Crea la cuenta de tu empresa, da de alta a tu equipo pegando una lista y
        empezad a fichar. 30 días gratis, sin tarjeta y sin compromiso.
      </p>
      <div class="hero-actions" style="justify-content: center;">
        <a href="https://forjia.es/registro" rel="noopener" class="btn btn--primary">
          Empieza gratis
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="/contacto" class="btn btn--ghost">Pide una demo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-white);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px 460px at 82% -8%, rgba(var(--color-accent-rgb), 0.2), transparent 60%),
      radial-gradient(760px 460px at 2% 4%, rgba(var(--color-primary-rgb), 0.1), transparent 55%);
    z-index: 0;
  }

  /* Cuadrícula decorativa muy tenue */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(15, 27, 51, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 27, 51, 0.035) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(700px 420px at 50% 30%, #000, transparent 78%);
    -webkit-mask-image: radial-gradient(700px 420px at 50% 30%, #000, transparent 78%);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  .hero h1 {
    margin-block: 1.1rem 1.25rem;
  }

  .hero h1 .accent {
    color: var(--color-primary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .hero-note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-shot {
    max-width: 380px;
    box-shadow: var(--shadow-lg);
  }

  /* Tarjetas de público */
  .audience-eyebrow {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.35rem;
  }

  .check-list--compact {
    margin-top: 1.1rem;
    gap: 0.55rem;
    font-size: 0.95rem;
  }

  .check-list--compact li {
    color: var(--color-text);
  }

  /* Bloque de cumplimiento */
  .compliance {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: center;
    background: linear-gradient(160deg, var(--color-white), var(--color-primary-light));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.75rem;
    box-shadow: var(--shadow-sm);
  }

  .compliance-badge {
    width: 92px;
    height: 92px;
    flex-shrink: 0;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    box-shadow: var(--shadow-md);
  }

  /* Tira horizontal de capturas */
  .shots-section {
    overflow: hidden;
  }

  .shots-strip {
    display: flex;
    gap: 1.25rem;
    margin-top: 3rem;
    padding-inline: max(1.5rem, calc((100vw - var(--content-width)) / 2));
    padding-bottom: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .shots-item {
    flex: 0 0 240px;
    scroll-snap-align: start;
  }

  /* Precios resumidos */
  .price {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .price h3 {
    margin-bottom: 0;
  }

  .price--featured {
    border-color: rgba(var(--color-primary-rgb), 0.45);
    box-shadow: var(--shadow-md);
  }

  .price--featured .pill {
    position: absolute;
    top: -0.9rem;
    left: 1.9rem;
  }

  .price-amount {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-dark);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .price-amount span {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0;
    margin-right: 0.25rem;
  }

  .price-amount small {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0;
  }

  .price-tiers {
    font-size: 0.85rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .price-note {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-shot {
      max-width: 300px;
    }

    .compliance {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.75rem;
    }

    .compliance-badge {
      width: 72px;
      height: 72px;
    }

    .shots-item {
      flex-basis: 200px;
    }
  }
</style>
