---
/**
 * Página de la plantilla Excel gratuita (/plantilla-registro-horario).
 * Landing corta que explica la plantilla de registro de jornada mensual
 * (art. 34.9 ET), para quién es y qué incluye, con botón de descarga directa
 * del .xlsx que vive en /public/descargas/. Debajo, el argumento honesto de
 * cuándo el Excel deja de servir y el CTA a la prueba gratuita de Forjia.
 *
 * DESCARGA SIN PEDIR EMAIL (decisión del dueño, septiembre 2026): no queremos
 * montar formularios ahora. Si en el futuro se quiere pedir el correo antes de
 * descargar, se puede reutilizar el mismo Web3Forms de /contacto (mismo
 * access_key, campo oculto "subject": "Descarga plantilla") y, tras el envío
 * correcto, redirigir o mostrar el enlace al archivo.
 *
 * El archivo .xlsx se genera con un script Node (exceljs) fuera del repo; si hay
 * que cambiar la plantilla, regenerarlo y sustituir el archivo en /public/descargas/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const archivo = '/descargas/plantilla-registro-horario-forjia.xlsx';
const urlArchivo = `https://naveosoft.es${archivo}`;

// Qué incluye la plantilla (tres hojas).
const incluye = [
  {
    icon: 'file',
    titulo: 'Hoja "Instrucciones"',
    texto: 'Qué exige el art. 34.9 del Estatuto de los Trabajadores, cómo rellenar cada columna, conservación 4 años y firma mensual.',
  },
  {
    icon: 'table',
    titulo: 'Hoja "Registro"',
    texto: 'Cabecera con empresa, CIF, trabajador, DNI y mes. Tabla de 31 días con entrada, salida, pausa, observaciones y firma diaria.',
  },
  {
    icon: 'clock',
    titulo: 'Horas calculadas solas',
    texto: 'Escribes entrada, salida y pausa; la plantilla calcula horas ordinarias y extra por día y los totales del mes.',
  },
  {
    icon: 'edit',
    titulo: 'Hoja "Resumen" con firmas',
    texto: 'Totales del mes y bloque de firma del trabajador y de la empresa, listo para imprimir o guardar en PDF y archivar.',
  },
];

// Para quién es.
const paraQuien = [
  'Autónomos con 1 o 2 empleados que quieren cumplir sin gastar nada',
  'Pymes muy pequeñas con horario fijo y un solo centro',
  'Empresas que aún no han decidido qué app usar y necesitan cumplir ya',
  'Gestorías que quieren dar algo a sus clientes que todavía fichan en papel',
];

// Cuándo el Excel deja de servir (argumento honesto).
const limites = [
  {
    titulo: 'Más de 5 personas',
    texto: 'Con 6 o más empleados, perseguir 6 archivos cada mes, revisar que estén rellenos y guardarlos bien se convierte en un trabajo en sí mismo. Y siempre falta uno.',
  },
  {
    titulo: 'Una Inspección',
    texto: 'Un Excel rellenado "de memoria" el último día es poco creíble ante un inspector: no hay hora real de fichaje, ni rastro de quién cambió qué. Un registro digital con auditoría sí lo tiene.',
  },
  {
    titulo: 'El registro digital de 2026',
    texto: 'La nueva norma que se tramita exige registros inalterables, con trazabilidad y accesibles en remoto por la Inspección. Un Excel, por definición, se puede editar sin dejar rastro.',
  },
];

// Datos estructurados del documento descargable (SEO).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DigitalDocument',
  name: 'Plantilla Excel de registro de jornada mensual (art. 34.9 ET)',
  description:
    'Plantilla gratuita en Excel para el registro horario mensual de los trabajadores, conforme al artículo 34.9 del Estatuto de los Trabajadores. Calcula horas ordinarias y extra e incluye hoja de resumen con firmas.',
  url: 'https://naveosoft.es/plantilla-registro-horario',
  inLanguage: 'es-ES',
  isAccessibleForFree: true,
  encodingFormat: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  contentUrl: urlArchivo,
  publisher: { '@type': 'Organization', name: 'Forjia', url: 'https://naveosoft.es' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<BaseLayout
  title="Plantilla Excel gratis de registro de jornada (art. 34.9 ET) — Forjia"
  description="Descarga gratis la plantilla Excel de registro horario mensual conforme al art. 34.9 del Estatuto de los Trabajadores. Calcula horas ordinarias y extra, con hoja de resumen y firmas. Sin registro ni email."
  jsonLd={jsonLd}
>
  <!-- ================= HERO + DESCARGA ================= -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Plantilla gratuita</span>
        <h1>Plantilla Excel de registro de jornada, lista para usar</h1>
        <p class="lead">
          Registro horario mensual conforme al art. 34.9 del Estatuto de los
          Trabajadores. Rellenas entrada, salida y pausa; las horas se calculan
          solas. Sin registro, sin email, sin trucos.
        </p>
        <div class="hero-actions">
          <a href={archivo} download class="btn btn--primary">
            <Icon name="download" size={18} />
            Descargar plantilla (.xlsx)
          </a>
          <a href="#limites" class="btn btn--secondary">¿Cuándo deja de servir?</a>
        </div>
        <p class="hero-note">
          Archivo Excel (.xlsx) · compatible con Excel, LibreOffice y Google Sheets · gratis para uso comercial.
        </p>
      </div>

      <!-- Tarjeta que resume la plantilla -->
      <aside class="preview reveal" aria-label="Contenido de la plantilla">
        <div class="preview-head">
          <span class="pill pill--success">Gratis</span>
          <span class="preview-name">plantilla-registro-horario-forjia.xlsx</span>
        </div>
        <ul class="preview-cols">
          <li>Fecha</li><li>Entrada</li><li>Salida</li><li>Pausa (min)</li>
          <li>Horas ordinarias</li><li>Horas extra</li><li>Observaciones</li><li>Firma</li>
        </ul>
        <ul class="check-list preview-list">
          <li><Icon name="check" size={16} /> 31 días por hoja, un trabajador por archivo</li>
          <li><Icon name="check" size={16} /> Fórmulas de horas y totales del mes</li>
          <li><Icon name="check" size={16} /> Instrucciones legales en la primera hoja</li>
          <li><Icon name="check" size={16} /> Resumen mensual con firmas</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ================= QUÉ INCLUYE ================= -->
  <section class="section section--light">
    <div class="container section-head reveal">
      <span class="eyebrow">Qué incluye</span>
      <h2>Tres hojas, todo lo que pide la ley</h2>
      <p class="lead">
        La plantilla cubre lo que un inspector espera ver en un registro manual:
        quién, qué día, a qué hora entra y sale, cuánto trabaja y quién lo firma.
      </p>
    </div>
    <div class="container" style="margin-top: 2.5rem;">
      <div class="grid grid--2 reveal">
        {
          incluye.map((i) => (
            <article class="card">
              <span class="icon-box"><Icon name={i.icon} /></span>
              <h3>{i.titulo}</h3>
              <p>{i.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= PARA QUIÉN ================= -->
  <section class="section">
    <div class="container who reveal">
      <div>
        <span class="eyebrow">Para quién es</span>
        <h2>Para empresas pequeñas que quieren cumplir hoy mismo</h2>
        <p class="lead">
          Si tienes pocos empleados, horario estable y un solo centro, un Excel
          bien llevado es un registro de jornada válido. Esta plantilla te ahorra
          montarlo desde cero.
        </p>
      </div>
      <ul class="check-list">
        {paraQuien.map((p) => <li><Icon name="check" size={16} /> {p}</li>)}
      </ul>
    </div>
  </section>

  <!-- ================= CUÁNDO DEJA DE SERVIR ================= -->
  <section class="section section--light" id="limites">
    <div class="container section-head reveal">
      <span class="eyebrow">Seamos honestos</span>
      <h2>Cuándo el Excel deja de servir</h2>
      <p class="lead">
        La plantilla es válida y gratis. Pero hay tres momentos en los que un
        Excel se queda corto, y conviene saberlo antes de que lleguen.
      </p>
    </div>
    <div class="container" style="margin-top: 2.5rem;">
      <div class="grid grid--3 reveal">
        {
          limites.map((l) => (
            <article class="card card--limit">
              <span class="icon-box icon-box--warn"><Icon name="alert" /></span>
              <h3>{l.titulo}</h3>
              <p>{l.texto}</p>
            </article>
          ))
        }
      </div>
      <p class="more-link text-center">
        Te contamos qué cambia con la nueva norma en el artículo
        <a href="/blog/registro-horario-digital-2026">Registro horario digital en 2026: qué exige la ley y cómo cumplir</a>.
      </p>
    </div>
  </section>

  <!-- ================= CTA FORJIA ================= -->
  <section class="section section--dark cta">
    <div class="container section-head reveal">
      <span class="eyebrow eyebrow--on-dark">La forma más sencilla de dejar el Excel</span>
      <h2>Cuando te quedes corto, Forjia</h2>
      <p class="lead">
        Fichaje desde el móvil o en modo kiosco con QR, informe listo para
        Inspección, Excel para la gestoría y conservación 4 años. Desde 15 € al
        mes por empresa. Prueba 30 días gratis, sin tarjeta.
      </p>
      <div class="hero-actions" style="justify-content: center;">
        <a href="https://forjia.es/registro" rel="noopener" class="btn btn--primary">
          Empieza gratis
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="/precios" class="btn btn--ghost">Ver precios</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    background:
      radial-gradient(1200px 500px at 80% -10%, rgba(var(--color-accent-rgb), 0.18), transparent 60%),
      radial-gradient(900px 500px at 0% 0%, rgba(var(--color-primary-rgb), 0.1), transparent 55%),
      var(--color-white);
    padding-block: clamp(3.5rem, 8vw, 5.5rem) clamp(3rem, 6vw, 5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero h1 {
    margin-block: 0.5rem 1.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero-note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  /* Tarjeta de vista previa de la plantilla */
  .preview {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-md);
  }

  .preview-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .preview-name {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    word-break: break-all;
  }

  .preview-cols {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem;
  }

  .preview-cols li {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-white);
    background: var(--color-primary);
    border-radius: 6px;
    padding: 0.45rem 0.4rem;
    text-align: center;
    line-height: 1.2;
  }

  .preview-list {
    margin-top: 1.25rem;
    gap: 0.6rem;
    font-size: 0.95rem;
  }

  /* Bloque "para quién" */
  .who {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }

  .who h2 {
    margin-block: 0.25rem 1rem;
  }

  /* Tarjetas de límites */
  .icon-box--warn {
    color: var(--color-warning);
    background: linear-gradient(160deg, rgba(var(--color-warning-rgb), 0.14), rgba(var(--color-warning-rgb), 0.06));
    border-color: rgba(var(--color-warning-rgb), 0.25);
  }

  .more-link {
    margin-top: 2.5rem;
    color: var(--color-text-muted);
  }

  .more-link a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .eyebrow--on-dark {
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .hero-grid,
    .who {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .preview {
      padding: 1.25rem;
    }

    .preview-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
